# Copy this file to .env and fill in real values. .env is git-ignored.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_NAME=NurseLink
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Leave EMAIL_HOST blank in DEBUG to use the console backend (OTP codes print
# to the runserver terminal instead of being emailed). Set these to send real
# mail, e.g. via a Gmail App Password or a transactional provider (SendGrid,
# Mailgun, SES SMTP, etc).
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NurseLink <no-reply@nurselink.local>

# Face verification stub mode: random | always_match | always_fail
FACE_MATCH_STUB_MODE=random

# Throttle overrides (DRF rate strings, e.g. "10/hour")
THROTTLE_FACE_VERIFICATION=30/hour
THROTTLE_OTP_SEND=10/hour
THROTTLE_OTP_VERIFY=30/hour
