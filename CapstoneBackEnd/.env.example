# Copy this file to .env and fill in real values. .env is git-ignored.
# Never commit real values: this file is for documentation only.

# --- Core ---------------------------------------------------------------------
# DJANGO_DEBUG is OFF unless set to True. Local development: True.
# Production: False (or unset). Stack traces, API docs and open CORS are debug-only.
DJANGO_DEBUG=True

# REQUIRED when DJANGO_DEBUG is off. Generate a fresh one, never reuse a value:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Leaving it unset in production stops the app from starting.
# Debug without it: a random key per process (sessions reset on restart).
# DJANGO_SECRET_KEY=

# REQUIRED when DJANGO_DEBUG is off: the exact host names the site is served on,
# comma-separated, e.g. nurselink.example.com. No wildcards.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# REQUIRED when DJANGO_DEBUG is off: the web app's real origin(s) (scheme +
# host, no trailing slash), comma-separated, e.g. https://app.nurselink.com.
# Without this, DEBUG=False blocks every browser request to the API.
# DJANGO_CORS_ALLOWED_ORIGINS=

# Optional. Only needed if the Django admin or the Scalar API docs will be
# used cross-origin (not the nurse-facing apps themselves — they authenticate
# with a Bearer token, which this doesn't apply to). Same origins as above.
# DJANGO_CSRF_TRUSTED_ORIGINS=

# When DJANGO_DEBUG is off, HTTPS is enforced: HTTP is redirected, cookies are
# Secure, HSTS is sent. Behind a load balancer that terminates TLS, set
# DJANGO_BEHIND_PROXY=True so the app trusts X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_BEHIND_PROXY=False
# DJANGO_HSTS_SECONDS=31536000

# --- Database (PostgreSQL) -----------------------------------------------------
DB_NAME=NurseLink
DB_USER=postgres
# REQUIRED when DJANGO_DEBUG is off. In debug, leave blank for a local Postgres
# that trusts local connections, or set your password.
# DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis (channel layer) -----------------------------------------------------
# REQUIRED in production, and for local dev if you want notifications to work
# across more than one server process. Leave unset to use the default below;
# `manage.py test` ignores this and always uses the in-memory layer. Set
# CHANNEL_LAYER_MEMORY=True to force the in-memory layer outside tests too
# (e.g. a dev machine with no Redis running — notifications then work only
# within a single process, same as before this setting existed).
REDIS_URL=redis://127.0.0.1:6379/0
# CHANNEL_LAYER_MEMORY=False

# n8n. Base URL + prefix already default to the shared NurseLink instance in
# test mode; leave blank to use those defaults. Flip N8N_WEBHOOK_PREFIX to
# "webhook" once the workflows are activated (test URLs only answer once,
# right after pressing "Execute workflow" on the n8n canvas).
# N8N_BASE_URL=https://nurselinks.app.n8n.cloud
# N8N_WEBHOOK_PREFIX=webhook-test
#
# Signup steps 1-3 (Hospital ID OCR + Face ID) share one consolidated
# workflow path, "identity-verify" — both default to it below. Autocharting
# is the only n8n workflow NOT part of signup.
# N8N_VERIFY_ID_PATH=identity-verify
# N8N_FACE_VERIFY_PATH=identity-verify
# N8N_STRUCTURE_CHART_PATH=structure-chart
# N8N_WEBHOOK_TOKEN=
#
# Optional full-URL override for PRC ID extraction specifically (multipart
# file upload, see api/n8n_client.py call_workflow_multipart). Also used for
# face_verify when set, since both actions hit the same consolidated
# workflow. Leave blank to use the composed URL above, which already
# resolves to the same address:
# N8N_IDENTITY_VERIFY_WEBHOOK=https://nurselinks.app.n8n.cloud/webhook/identity-verify
# N8N_AUTO_CHARTING_WEBHOOK_URL=https://nurselinks.app.n8n.cloud/webhook/structure-chart
#
# True routes Step 3 (face check) through the n8n workflow above instead of
# the local OpenCV fallback. False (default) means no n8n call is made for
# face verification — no execution ever shows in n8n.
# N8N_FACE_VERIFY_ENABLED=False

# REQUIRED for Email OTP — real SMTP provider (do not leave blank).
# Example (Gmail App Password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=your@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=NurseLink <your@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NurseLink <no-reply@nurselink.local>

# Preferred over the SMTP settings above whenever set — used for OTP email
# delivery on hosts (e.g. Render) that block outbound SMTP. BREVO_SENDER_EMAIL
# must be a verified sender on the Brevo account (Settings > Senders), not an
# arbitrary address.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NurseLink

# Throttle overrides (DRF rate strings, e.g. "10/hour")
THROTTLE_FACE_VERIFICATION=30/hour
THROTTLE_OTP_SEND=10/hour
THROTTLE_OTP_VERIFY=30/hour

# Best-effort similarity threshold (0-100) sent to the n8n face-verify
# workflow (used for both Hospital ID and PRC license face matching). Only
# takes effect if that workflow's AWS Rekognition node is wired to read and
# apply it — Django cannot force this. Does NOT affect the local OpenCV
# fallback matcher below — the two engines use different, incompatible scales.
FACE_SIMILARITY_THRESHOLD=85

# Cosine-similarity threshold (0.0-1.0 scale) for the LOCAL OpenCV SFace
# matcher only (used when N8N_FACE_VERIFY_ENABLED=False, or as the n8n
# fallback). 0.363 is the official OpenCV Zoo SFace verification threshold
# for this exact model — do not change it casually.
FACE_MATCH_THRESHOLD=0.363

# Face verification attempt cap before Email OTP is offered as a fallback.
MAX_FACE_VERIFICATION_ATTEMPTS=3

# Registration OTP lifecycle.
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
# --- Login brute-force protection (api/login_throttle.py) ---
# Counters are stored in the database by default (shared, survive restarts).
# Set a Redis URL to use Redis instead, e.g. redis://localhost:6379/1
# LOGIN_THROTTLE_REDIS_URL=
# LOGIN_THROTTLE_ACCOUNT_MAX_FAILURES=5
# LOGIN_THROTTLE_ACCOUNT_WINDOW_SECONDS=900
# LOGIN_THROTTLE_ACCOUNT_LOCKOUT_SECONDS=900
# LOGIN_THROTTLE_ACCOUNT_LOCKOUT_MAX_SECONDS=86400
# LOGIN_THROTTLE_IP_MAX_FAILURES=20
# LOGIN_THROTTLE_IP_WINDOW_SECONDS=900
# LOGIN_THROTTLE_IP_LOCKOUT_SECONDS=900
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs).
# Leave empty when clients connect to Django directly.
# TRUSTED_PROXIES=

# --- Session tokens (api/authentication.py, api/consumers.py) ---------------
# How long an AuthSession (login token) stays valid, in seconds. Checked on
# every authenticated request and WebSocket connect. Default: 24 hours.
# TOKEN_TTL_SECONDS=86400

# --- WebSocket connect tickets (api/ws_tickets.py) ---------------------------
# Lifetime of a one-time ticket from POST /api/auth/ws-ticket/, in seconds.
# Short by design — long enough to open the socket, short enough that one
# leaking into a log is useless shortly after. Default: 45 seconds.
# WS_TICKET_TTL_SECONDS=45
# Counters are stored in the database by default (shared, survive restarts).
# Set a Redis URL to use Redis instead, e.g. redis://localhost:6379/2
# WS_TICKET_REDIS_URL=

# Encryption key for sensitive patient fields (api/encryption.py). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up — losing it makes encrypted patient data unreadable.
FIELD_ENCRYPTION_KEY=
